+// --- SuperBuilders novel-item gate: points-at-stake / readiness gap ---------
+
+message ConceptGap {
+  // The cards belonging to this concept (card_mastery is their mean FSRS
+  // retrievability, computed natively in Rust).
+  repeated int64 card_ids = 1;
+  // Accuracy on novel items for this concept, in [0, 1] (supplied by the
+  // add-on's gap.db sidecar; not part of the Anki collection).
+  double novel_accuracy = 2;
+  // Exam weight for this concept.
+  double exam_weight = 3;
+  // Opaque concept identifier echoed back in the response.
+  string concept_code = 4;
+}
+
+message ComputeReadinessGapRequest {
+  repeated ConceptGap concepts = 1;
+}
+
+message ConceptStake {
+  string concept_code = 1;
+  // Mean FSRS retrievability over the concept's cards, in [0, 1].
+  double card_mastery = 2;
+  double novel_accuracy = 3;
+  double exam_weight = 4;
+  // (card_mastery - novel_accuracy) * exam_weight.
+  double points = 5;
+}
+
+message ComputeReadinessGapResponse {
+  // Concepts ordered by points descending (largest gap first).
+  repeated ConceptStake ordered = 1;
+}
